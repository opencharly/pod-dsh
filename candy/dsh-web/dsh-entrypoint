#!/usr/bin/env bash
set -e

# dsh-web-app rejects --host 0.0.0.0 (RCE safety) and binds 127.0.0.1:3080 ONLY.
# A container's published port maps to the container's eth0 (0.0.0.0), not
# loopback — so run `dsh web` on loopback and let socat expose it on eth0.
# socat CANNOT share port 3080: Linux forbids a wildcard (0.0.0.0) and a
# specific (127.0.0.1) listener on the same port — whichever binds second fails
# with EADDRINUSE (SO_REUSEADDR does not permit the pair). So socat listens on
# 0.0.0.0:3081 and forwards to 127.0.0.1:3080; the published port (auto-allocated
# host port -> container 3081) reaches the web app through socat. On the vm
# substrate the ssh -L forward targets loopback directly — socat just doesn't
# hurt there.
#
# The web UI requires authentication (dsh-web-app >= 0.1.5-rc.x): each process
# mints a random launch token and `dsh web` prints it in its
# `dsh web: http://127.0.0.1:3080/?token=...` readiness line. The supervised
# wrapper stays RUNNING regardless of the web app's fate (a crash is caught by
# supervisord only if the wrapper exits), so the service probe alone cannot tell
# a live web app from a dead one. Capture the token from that readiness line,
# persist it to $DSH_HOME/web-token, and let the in-box checks authenticate with
# it. Persisting it on the DSH_HOME volume also survives the fresh `charly
# update` rebuild the R10 bed performs.
#
# The dsh binary lives in the npm-global bin (NPM_CONFIG_PREFIX from the nodejs
# candy); the service environment may not carry the candy's path_append, so set
# PATH explicitly. Derive the homedir from passwd when $HOME is unset (the same
# getent discovery the nodejs candy's pnpm check prescribes — live-container
# execs provide no HOME).
HOME_DIR="${HOME:-$(getent passwd "$(id -u)" | cut -d: -f6)}"
export PATH="${HOME_DIR}/.npm-global/bin:$PATH"
DSH_HOME_DIR="${DSH_HOME:-${HOME_DIR}/.dsh}"
mkdir -p "${DSH_HOME_DIR}"
TOKEN_FILE="${DSH_HOME_DIR}/web-token"
# Drop any stale token first: a check must never authenticate with the previous
# process's launch token (the new one is written before socat starts serving).
rm -f "${TOKEN_FILE}"

# Seed the volume's ollama-cloud LLM route on FIRST use, from the copy the shared
# `dsh` candy installs OUTSIDE the named volume. The route is shipped by `dsh`,
# whose build-time ~/.dsh copy is SHADOWED by this volume, so the entrypoint
# restores it from the durable ~/.local/share/dsh copy (ONE authored file in
# candy/dsh; no duplicated catalog).
if [ ! -f "${DSH_HOME_DIR}/cordis.patch.yml" ]; then
  ROUTE="${HOME_DIR}/.local/share/dsh/cordis.patch.yml"
  [ -f "${ROUTE}" ] && cp "${ROUTE}" "${DSH_HOME_DIR}/cordis.patch.yml"
fi

# Seed the web profile (manifest + the INSTALLED node_modules) on first use, from
# the durable copy this candy installs at BUILD time. The `dsh` named volume
# shadows the image's ~/.dsh, so the baked profile is unreachable from the volume
# path; the candy installs it to ~/.local/share/dsh/profile-home instead and this
# copies it in. Gated on node_modules (not the manifest) so a volume that predates
# this seeding is upgraded to the pinned, fully-installed bundle set.
if [ ! -d "${DSH_HOME_DIR}/profiles/web/node_modules" ]; then
  STAGE="${HOME_DIR}/.local/share/dsh/profile-home/profiles/web"
  if [ -d "${STAGE}" ]; then
    mkdir -p "${DSH_HOME_DIR}/profiles"
    rm -rf "${DSH_HOME_DIR}/profiles/web"
    cp -a "${STAGE}" "${DSH_HOME_DIR}/profiles/web"
  fi
fi

WEB_LOG="$(mktemp)"
# dsh web's SECOND auth layer is the Host/Origin browser-trust fence: the request
# `Host` must be loopback or match a `trustedHosts` entry, or EVERY request —
# including every `/api/*` call — gets 403 forbidden. Behind a reverse proxy
# (tailscale serve, an SSH -L tunnel, an ingress) the forwarded Host is the proxy
# authority, not loopback, so a deployed pod exposed that way renders a dead page
# unless the authority is trusted. DSH_WEB_TRUSTED_HOSTS (space/comma separated
# `host:port` values) is forwarded as one repeatable --trusted-host per entry;
# unset means loopback-only, which is correct for the default in-pod case.
TRUSTED_ARGS=()
for _h in ${DSH_WEB_TRUSTED_HOSTS//,/ }; do
  [ -n "${_h}" ] && TRUSTED_ARGS+=(--trusted-host "${_h}")
done
dsh web --no-open "${TRUSTED_ARGS[@]}" >"${WEB_LOG}" 2>&1 &
WEB_PID=$!

# Wait for the authenticated URL line (or for dsh web to die). Bounded: if the
# web app never comes up, socat still runs and the in-box checks report it.
for _ in $(seq 1 60); do
  if grep -q 'token=' "${WEB_LOG}" 2>/dev/null; then
    break
  fi
  if ! kill -0 "${WEB_PID}" 2>/dev/null; then
    break
  fi
  sleep 1
done

TOKEN="$(sed -n 's#.*[?&]token=\([^ &]*\).*#\1#p' "${WEB_LOG}" | head -n 1)"
if [ -n "${TOKEN}" ]; then
  printf '%s' "${TOKEN}" > "${TOKEN_FILE}"
  chmod 0644 "${TOKEN_FILE}"
fi

# Surface the web app's own startup output — the token line, or the crash
# trace — through the supervisor log, so a dead web app is never silent.
cat "${WEB_LOG}" >&2 || true

exec socat TCP-LISTEN:3081,fork,reuseaddr TCP:127.0.0.1:3080
